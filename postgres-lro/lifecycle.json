      { "id": "happy-path", "label": "Claim to completion", "focus": ["queued", "running", "done"], "note": "A row is claimed out of workitems_active, runs under a lease, and is released as done." },
      { "id": "lease-recovery", "label": "Lease recovery", "focus": ["running", "lapsed", "failed"], "note": "A lease that stops being renewed makes the row claimable again until the retry budget runs out." },
      { "id": "exits", "label": "Exits without a result", "focus": ["queued", "expired", "canceled"], "note": "Queue expiry and caller cancellation end the item before any compute result exists." }
