  "cards": [
    { "dot": "cyan", "title": "Claiming", "items": ["Only queued rows and lapsed running rows satisfy the claim predicate", "One UPDATE guarded by FOR UPDATE SKIP LOCKED moves queued to running", "Every claim increments claimed_count and stamps claimed_by"] },
    { "dot": "emerald", "title": "The lease", "items": ["claimed_until is set to NOW() plus the 7s claim duration", "The worker calls RefreshClaim every 5s for as long as the task runs", "A lease that stops being renewed returns the row to the claimable set"] },
    { "dot": "rose", "title": "Ending the item", "items": ["Both release paths move the row from workitems_active into workitems_inactive", "An exhausted retry budget is recorded as failed, not as a distinct status", "Cancel drains any active row, whether it is queued or already running"] },
    { "dot": "slate", "title": "Outside the machine", "items": ["A storage purge soft-deletes the item and stamps deleted_at", "It applies to an active row and to an already terminal one alike", "So deleted is a retention state, not a step in this flow"] }
  ]
