    { "dot": "cyan", "title": "One row per iteration", "items": ["Each workerLoop pass opens its own root span and claims at most one row", "An empty queue returns nothing and the loop backs off by claimRetryTimeout", "A claim error uses the same backoff, so a sick database is not hot-polled"] },
    { "dot": "emerald", "title": "The renewal goroutine", "items": ["startClaimRenewal spawns a goroutine before Task.Run is entered", "It selects between its stop channel and a 5s timer that calls RefreshClaim", "Each refresh pushes claimed_until forward by the 7s claim duration"] },
    { "dot": "rose", "title": "Why the stop order differs", "items": ["On success the release is written first and renewal is stopped afterwards", "On error renewal is stopped first so no refresh can revive a dying claim", "Either way the row leaves workitems_active exactly once"] },
    { "dot": "slate", "title": "Concurrency", "items": ["maxConcurrency identical loops run against the same queue", "SKIP LOCKED is what keeps them from claiming the same row", "The process then blocks on ctx.Done and lets the loops drain"] }
